JWT_ISSUER=stagelog-auth
JWT_AUDIENCE=stagelog-api
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600
JWT_SECRET_KEY=replace-me
# Example: {"kty":"oct","k":"base64url-secret","alg":"HS256","use":"sig","kid":"local-dev"}
JWT_PUBLIC_JWK={}
# Optional in Lambda: comma-separated SSM prefixes loaded at cold start
AUTH_SSM_PREFIXES=

DB_HOST=stagelog-db-managed-v2.c922amcmeywm.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=stagelog_auth_user
DB_PASSWORD=Goormdb123!
DB_NAME=stagelog_auth
# Optional: custom CA bundle path. Leave empty to use runtime default trust store.
DB_SSL_CA=

REDIS_HOST=stagelog-redis.uaksc2.ng.0001.apn2.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=False
